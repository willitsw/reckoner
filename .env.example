# Copy to `.env` and fill in when you create a Supabase project.
# URL must include https://. Use the publishable or legacy anon key from Project Settings → API.
# Never commit real secrets.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PowerSync instance URL (Sync Streams). With Supabase env set, DI uses the
# PowerSync ProcessRepository; omit for memory adapters (tests/CI).
EXPO_PUBLIC_POWERSYNC_URL=

# Script-only (never EXPO_PUBLIC_). Used by `npm run seed:dev` to create the demo login.
SUPABASE_SERVICE_ROLE_KEY=

# Auth email links open the app. In Authentication → URL Configuration, allowlist:
#   reckoner://**
#   http://localhost:8081/**
#   and the deployed web origin, if any.

